---
// src/components/AuthorBio.astro
const author = {
  name: "Iqbal Maulana",
  role: "Head of Research at AI Labs",
  bio: "Spesialis Web3 Developer dan Analis RWA. Fokus pada integrasi aset dunia nyata ke dalam jaringan Solana dan Base untuk menciptakan ekosistem finansial yang lebih inklusif.",
  links: {
    github: "https://github.com/yusuf", // Menyesuaikan dengan data sistem Anda
    twitter: "#",
    linkedin: "#"
  }
};
---

<div class="p-8 rounded-[2rem] bg-[#080a0f] border border-white/5 relative overflow-hidden group">
    <div class="absolute top-0 right-0 p-8 opacity-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-cyan-500"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
    </div>
    
    <div class="flex flex-col md:flex-row gap-8 items-center relative z-10">
        <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 p-[1px]">
            <div class="w-full h-full rounded-2xl bg-[#05070a] flex items-center justify-center overflow-hidden">
                <span class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">IM</span>
            </div>
        </div>
        
        <div class="flex-1 text-center md:text-left">
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-cyan-500 mb-2 font-mono">Expert Contributor</p>
            <h4 class="text-2xl font-bold text-white mb-3 font-sans italic">{author.name}</h4>
            <p class="text-slate-400 leading-relaxed text-sm mb-6 max-w-2xl font-sans">
                {author.bio}
            </p>
            
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
                <a href={author.links.github} class="text-[10px] font-bold text-white/40 hover:text-cyan-400 transition-colors uppercase tracking-widest font-mono">GitHub</a>
                <a href={author.links.linkedin} class="text-[10px] font-bold text-white/40 hover:text-cyan-400 transition-colors uppercase tracking-widest font-mono">LinkedIn</a>
                <a href={author.links.twitter} class="text-[10px] font-bold text-white/40 hover:text-cyan-400 transition-colors uppercase tracking-widest font-mono">Research Portal</a>
            </div>
        </div>
    </div>
</div>