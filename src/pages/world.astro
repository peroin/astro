---
// src/pages/world.astro
import { getCollection } from 'astro:content';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');

// Filter post khusus kategori world
const worldPosts = allPosts
  .filter(post => post.id.startsWith('world/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Destructuring untuk Headline & Sidebar (DIPERTAHANKAN SESUAI KODE ASLI)
const [mainHeadline, ...otherPosts] = worldPosts;
const topStories = otherPosts.slice(0, 3);
const analysisSide = otherPosts.slice(3, 6);
const mostPopular = worldPosts.slice(0, 8); 

// Helper functions
const getCategoryPosts = (slug: string) => worldPosts.filter(post => post.id.includes(`world/${slug}/`));
const getUrl = (id: string) => `/world/${id.replace('world/', '')}`;

// PERBAIKAN: Menyelaraskan ID dengan skema KATEGORI_PROJECT di Keystatic Anda
const categories = [
    { id: 'america', label: 'America' },
    { id: 'eurozone', label: 'Eurozone' },
    { id: 'asia-pasific', label: 'Asia Pasific' }, 
    { id: 'geopolitics', label: 'Geopolitics' },
    { id: 'mena', label: 'MENA' }
];
---

<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="World Intelligence | Daily RWA" description="Analisis makro global dan intelijen kebijakan." />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght=0,700;0,900;1,700&family=Inter:wght=400;500;700;900&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --modern-bg: #f8f9fa; /* Latar belakang Off-White yang teduh */
            --modern-black: #333333; /* Dark Charcoal lembut sebagai pengganti hitam pekat */
            --brand-red: #ff3333; /* Warna merah aksen modern */
        }
        body { 
            background-color: var(--modern-bg) !important; 
            color: var(--modern-black); 
            font-family: 'Inter', sans-serif; 
        }
        .font-serif { font-family: 'Playfair Display', serif; }
        .wsj-double-rule { border-top: 3px double var(--modern-black); }
        .wsj-thin-rule { border-top: 1px solid rgba(51, 51, 51, 0.15); }
        .column-divider { border-right: 1px solid rgba(51, 51, 51, 0.15); }
        .no-scrollbar::-webkit-scrollbar { display: none; }

        @media (max-width: 1024px) {
            .column-divider { border-right: none; border-bottom: 1px solid rgba(51, 51, 51, 0.15); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        }

        /* Custom Scrollbar subtle agar senada */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--modern-bg); }
        ::-webkit-scrollbar-thumb { background: #dcdcdc; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--modern-black); }
    </style>
</head>

<body class="antialiased selection:bg-[#333333] selection:text-white">

    <!-- HEADER -->
    <header class="max-w-7xl mx-auto px-4 pt-6 pb-4 text-center">
        <a href="/" class="inline-block group">
            <h1 class="text-4xl md:text-5xl font-serif font-black italic tracking-tighter text-[#333333] transition-colors group-hover:text-black">
                DAILY <span class="text-[#ff3333] not-italic">RWA</span>
            </h1>
        </a>
    </header>

    <!-- SLOT IKLAN 1: TOP LEADERBOARD AD -->
    <div class="w-full flex justify-center mb-6 mt-2 px-4">
        <div class="w-full max-w-[728px] h-[90px] bg-white border border-[#333333]/10 flex flex-col items-center justify-center relative group rounded-lg shadow-sm">
            <span class="absolute top-2 left-3 text-[7px] tracking-widest font-mono text-gray-400 uppercase">Sponsored Announcement</span>
            <p class="text-[10px] font-mono text-gray-400 group-hover:text-[#333333] transition-colors">Leaderboard Banner Space [728x90]</p>
        </div>
    </div>

    <!-- MAIN NAV (Menggunakan Charcoal Gelap Pekat untuk kedalaman struktural) -->
    <nav class="bg-[#1a1a1a] sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4">
            <ul class="flex justify-center items-center gap-6 md:gap-8 py-3.5 text-[11px] font-black uppercase tracking-[0.2em] overflow-x-auto no-scrollbar">
                <li><a href="/" class="text-gray-400 hover:text-white transition-colors whitespace-nowrap">Home</a></li>
                <li><a href="/world" class="text-white border-b-2 border-[#ff3333] pb-1 whitespace-nowrap">World</a></li>
                <li><a href="/market" class="text-gray-400 hover:text-white transition-colors whitespace-nowrap">Market</a></li>
                <li><a href="/company" class="text-gray-400 hover:text-white transition-colors whitespace-nowrap">Company</a></li>
                <li><a href="/digital-asset" class="text-gray-400 hover:text-white transition-colors whitespace-nowrap">Digital Asset</a></li>
            </ul>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 mt-8">
        
        <!-- TOP SECTION (DIPERTAHANKAN UTUH) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
            <section class="lg:col-span-8 column-divider lg:pr-8">
                {worldPosts.length > 0 && mainHeadline && (
                    <article class="bg-white border border-[#333333]/10 p-5 rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
                        <div class="flex flex-col-reverse md:flex-row gap-6 mb-6">
                            <div class="md:w-1/3 flex flex-col justify-between">
                                <div>
                                    <a href={getUrl(mainHeadline.id)}>
                                        <h2 class="text-2xl md:text-3xl font-serif font-bold leading-tight mb-3 text-[#333333] hover:text-[#ff3333] transition-colors">
                                            {mainHeadline.data.title}
                                        </h2>
                                    </a>
                                    <p class="text-xs text-gray-600 leading-relaxed mb-4 font-medium">{mainHeadline.data.description}</p>
                                </div>
                                <span class="text-[9px] font-bold text-[#ff3333] uppercase border-t border-[#ff3333] pt-1.5 self-start">Core Intel</span>
                            </div>
                            <div class="md:w-2/3">
                                <div class="aspect-video overflow-hidden border border-[#333333]/5 shadow-sm rounded-lg">
                                    <img src={mainHeadline.data.image} alt={mainHeadline.data.title} class="w-full h-full object-cover transition-transform duration-700 hover:scale-102" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Berita tanpa gambar di bawah headline utama -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 wsj-thin-rule pt-6">
                            {topStories.map(post => (
                                <article class="group">
                                    <a href={getUrl(post.id)}>
                                        <h3 class="text-sm font-bold leading-tight mb-1 text-[#333333] group-hover:text-[#ff3333] transition-all">{post.data.title}</h3>
                                        <p class="text-[10px] text-gray-500 line-clamp-2 font-medium">{post.data.description}</p>
                                    </a>
                                </article>
                            ))}
                        </div>
                    </article>
                )}
            </section>

            <aside class="lg:col-span-4">
                <div class="bg-white border border-[#333333]/10 p-5 rounded-xl shadow-sm">
                    <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-[#333333] pb-1 text-[#333333]">Opinion & Analysis</h4>
                    <div class="space-y-4 divide-y divide-gray-100">
                        {analysisSide.map((post, idx) => (
                            <div class={idx === 0 ? "pb-4" : "pt-4 pb-4 last:pb-0"}>
                                <a href={getUrl(post.id)} class="group">
                                    <h5 class="text-md font-serif font-bold leading-snug text-[#333333] group-hover:text-[#ff3333] transition-colors">{post.data.title}</h5>
                                    <p class="text-[10px] text-gray-400 mt-1 italic font-medium">By {post.data.author || 'Analyst'}</p>
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            </aside>
        </div>

        <!-- STICKY SUB-NAV (Sub Nav Filter Kategori Mandiri) -->
        <nav class="bg-[#262626] sticky top-[49px] z-40 mb-12 shadow-md border-y border-white/5 rounded-lg">
            <div class="max-w-7xl mx-auto px-4 text-center">
                <ul class="flex justify-start md:justify-center items-center gap-3 py-2.5 text-[10px] font-black uppercase tracking-widest overflow-x-auto no-scrollbar">
                    {categories.map(cat => (
                        <li>
                            <a 
                                href={`#${cat.id}`} 
                                class="text-gray-300 bg-white/5 border border-white/10 hover:border-white hover:text-[#333333] hover:bg-white px-4 py-2 transition-all block whitespace-nowrap rounded-sm"
                            >
                                {cat.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </nav>

        <!-- CATEGORY FEED & SIDEBAR POPULAR -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-9">
                <div class="space-y-20">
                    {categories.map((cat, index) => {
                        const posts = getCategoryPosts(cat.id);
                        if (posts.length === 0) return null;
                        const [firstPost, ...listPosts] = posts.slice(0, 5);

                        return (
                            <>
                                <section id={cat.id} class="wsj-double-rule pt-4 scroll-mt-32">
                                    <h2 class="text-[11px] font-black uppercase tracking-[0.2em] mb-6 inline-block bg-[#333333] text-white px-2.5 py-1 font-mono rounded-sm">
                                        // {cat.label}
                                    </h2>
                                    <div class="grid grid-cols-1 md:grid-cols-9 gap-6">
                                        <div class="md:col-span-4 column-divider md:pr-6">
                                            <article class="group bg-white border border-[#333333]/10 p-4 rounded-xl shadow-sm">
                                                <div class="aspect-[4/3] overflow-hidden bg-gray-100 mb-3 border border-[#333333]/5 rounded-lg">
                                                    <img src={firstPost.data.image} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103" alt={firstPost.data.title}/>
                                                </div>
                                                <a href={getUrl(firstPost.id)}>
                                                    <h3 class="text-[15px] font-bold text-[#333333] group-hover:text-[#ff3333] transition-colors leading-tight font-serif">
                                                        {firstPost.data.title}
                                                    </h3>
                                                    <p class="text-xs text-gray-600 mt-2 line-clamp-3 leading-relaxed font-medium">{firstPost.data.description}</p>
                                                </a>
                                            </article>
                                        </div>
                                        <div class="md:col-span-5 space-y-4">
                                            {listPosts.map((post) => (
                                                <article class="bg-white border border-[#333333]/5 p-3.5 rounded-xl shadow-sm transition-all duration-300 hover:border-[#333333]/20">
                                                    <a href={getUrl(post.id)} class="group flex gap-4 text-[#333333]">
                                                        <div class="flex-grow">
                                                            <h4 class="text-[13px] font-bold text-[#333333] group-hover:text-[#ff3333] transition-colors leading-snug mb-1">{post.data.title}</h4>
                                                            <p class="text-[11px] text-gray-500 line-clamp-2 leading-relaxed font-medium">{post.data.description}</p>
                                                        </div>
                                                        {post.data.image && (
                                                            <div class="w-16 h-16 flex-shrink-0 bg-gray-100 border border-[#333333]/10 rounded-md overflow-hidden">
                                                                <img src={post.data.image} class="w-full h-full object-cover" alt="" />
                                                            </div>
                                                        )}
                                                    </a>
                                                </article>
                                            ))}
                                        </div>
                                    </div>
                                </section>

                                <!-- SLOT IKLAN 2: IN-FEED EDITORIAL AD -->
                                {index === 1 && (
                                    <div class="w-full py-4 my-8 flex justify-center border-y border-[#333333]/10 bg-white rounded-xl shadow-sm">
                                        <div class="w-full max-w-[728px] h-[90px] flex flex-col items-center justify-center relative group">
                                            <span class="text-[7px] tracking-widest font-mono text-gray-400 uppercase mb-1">Sponsored Briefing</span>
                                            <div class="text-[11px] font-mono text-gray-400 group-hover:text-[#333333] transition-colors border border-dashed border-[#333333]/20 px-8 py-2 rounded">
                                                In-Feed Mid Banner Ad [728x90]
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </>
                        );
                    })}
                </div>
            </div>

            <!-- SIDEBAR POPULAR & STICKY AD -->
            <aside class="lg:col-span-3">
                <div class="sticky top-32 space-y-10">
                    <div class="bg-white border border-[#333333]/10 p-4 rounded-xl shadow-sm">
                        <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-[#333333] pb-1 text-[#333333]">Most Popular</h4>
                        <div class="divide-y divide-gray-100">
                            {mostPopular.map((post, index) => (
                                <div class="flex gap-4 py-4 first:pt-0 text-[#333333]">
                                    <span class="text-2xl font-serif font-bold text-gray-300 leading-none min-w-[24px]">{index + 1}</span>
                                    <a href={getUrl(post.id)} class="group">
                                        <h5 class="text-[12px] font-bold text-[#333333] leading-tight group-hover:text-[#ff3333] transition-colors">{post.data.title}</h5>
                                    </a>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- SLOT IKLAN 3: SIDEBAR STICKY AD -->
                    <div class="pt-4 border-t border-[#333333]/10 flex flex-col items-center justify-center relative group">
                        <span class="text-[7px] tracking-widest font-mono text-gray-400 uppercase mb-2 self-start rounded">Advertisement Space</span>
                        <div class="w-[300px] h-[250px] bg-white border border-[#333333]/10 flex items-center justify-center text-[11px] font-mono text-gray-400 group-hover:text-[#333333] transition-colors rounded-xl shadow-sm">
                            Square Ad Space [300x250]
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <Footer />

</body>
</html>