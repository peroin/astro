---
// src/pages/world.astro
import { getCollection } from 'astro:content';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');

// Filter post khusus kategori world
const worldPosts = allPosts
  .filter(post => post.id.startsWith('world/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Destructuring untuk Headline & Sidebar
const [mainHeadline, ...otherPosts] = worldPosts;
const topStories = otherPosts.slice(0, 3);
const analysisSide = otherPosts.slice(3, 6);
const mostPopular = worldPosts.slice(0, 8); 

// Helper functions
const getCategoryPosts = (slug: string) => worldPosts.filter(post => post.id.includes(`world/${slug}/`));
const getUrl = (id: string) => `/world/${id.replace('world/', '')}`;

const categories = [
    { id: 'america', label: 'America' },
    { id: 'geopolitics', label: 'Geopolitics' },
    { id: 'eurozone', label: 'Eurozone' },
    { id: 'apac', label: 'Asia-Pacific' },
    { id: 'mena', label: 'MENA' },
    { id: 'digital-asset', label: 'Digital Asset' }
];
---

<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="World Intelligence | Daily RWA" description="Analisis makro global dan intelijen kebijakan." />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --wsj-bg: #fffcf5;
            --wsj-black: #1a1a1a;
            --brand-red: #990000;
        }
        body { background-color: var(--wsj-bg); color: var(--wsj-black); font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .wsj-double-rule { border-top: 3px double #000; }
        .wsj-thin-rule { border-top: 1px solid #d2d2d2; }
        .column-divider { border-right: 1px solid #e0e0e0; }
        .no-scrollbar::-webkit-scrollbar { display: none; }

        @media (max-width: 1024px) {
            .column-divider { border-right: none; border-bottom: 1px solid #e0e0e0; padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        }
    </style>
</head>

<body class="antialiased">

    <!-- HEADER -->
    <header class="max-w-7xl mx-auto px-4 pt-6 pb-4 text-center">
        <a href="/" class="inline-block">
            <h1 class="text-5xl md:text-6xl font-serif font-black italic tracking-tighter">
                DAILY <span class="text-[#990000]">RWA</span>
            </h1>
        </a>
    </header>

    <!-- MAIN NAV -->
    <nav class="border-y border-black bg-[#fffcf5] z-50">
        <div class="max-w-7xl mx-auto px-4">
            <ul class="flex justify-center items-center gap-6 md:gap-8 py-3 text-[11px] font-black uppercase tracking-[0.2em] overflow-x-auto no-scrollbar">
                <li><a href="/" class="hover:text-[#990000] whitespace-nowrap">Home</a></li>
                <li><a href="/world" class="text-[#990000] whitespace-nowrap">World</a></li>
                <li><a href="/market" class="hover:text-[#990000] whitespace-nowrap">Market</a></li>
                <li><a href="/company" class="hover:text-[#990000] whitespace-nowrap">Company</a></li>
                <li><a href="/digital-asset" class="hover:text-[#990000] whitespace-nowrap">Digital Asset</a></li>
            </ul>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 mt-8">
        
        <!-- TOP SECTION -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
            <section class="lg:col-span-8 column-divider lg:pr-8">
                {mainHeadline && (
                    <article>
                        <div class="flex flex-col-reverse md:flex-row gap-6 mb-6">
                            <div class="md:w-1/3">
                                <a href={getUrl(mainHeadline.id)}>
                                    <h2 class="text-2xl md:text-3xl font-serif font-bold leading-tight mb-3 hover:text-[#990000]">
                                        {mainHeadline.data.title}
                                    </h2>
                                </a>
                                <p class="text-xs text-gray-700 leading-relaxed mb-4">{mainHeadline.data.description}</p>
                                <span class="text-[9px] font-bold text-[#990000] uppercase border-t border-[#990000] pt-1">Editor's Choice</span>
                            </div>
                            <div class="md:w-2/3">
                                <div class="aspect-video overflow-hidden border border-gray-200">
                                    <img src={mainHeadline.data.image} alt={mainHeadline.data.title} class="w-full h-full object-cover" />
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 wsj-thin-rule pt-6">
                            {topStories.map(post => (
                                <article>
                                    <a href={getUrl(post.id)} class="group">
                                        <h3 class="text-sm font-bold leading-tight mb-1 group-hover:underline">{post.data.title}</h3>
                                        <p class="text-[10px] text-gray-500 line-clamp-2">{post.data.description}</p>
                                    </a>
                                </article>
                            ))}
                        </div>
                    </article>
                )}
            </section>

            <aside class="lg:col-span-4">
                <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-black pb-1">Opinion & Analysis</h4>
                <div class="space-y-6">
                    {analysisSide.map(post => (
                        <div class="border-b border-gray-100 last:border-0 pb-4">
                            <a href={getUrl(post.id)} class="group">
                                <h5 class="text-md font-serif font-bold leading-snug group-hover:text-[#990000]">{post.data.title}</h5>
                                <p class="text-[10px] text-gray-400 mt-1 italic font-medium">By Iqbal Maulana</p>
                            </a>
                        </div>
                    ))}
                </div>
            </aside>
        </div>

        <!-- STICKY SUB-NAV -->
        <nav class="border-y border-black sticky top-0 bg-[#fffcf5]/95 backdrop-blur-sm z-40 mb-8 shadow-sm">
            <div class="max-w-7xl mx-auto px-4 text-center">
                <ul class="flex justify-center items-center gap-6 py-2 text-[10px] font-black uppercase tracking-widest overflow-x-auto no-scrollbar">
                    {categories.map(cat => (
                        <li><a href={`#${cat.id}`} class="text-gray-500 hover:text-black hover:underline whitespace-nowrap">{cat.label}</a></li>
                    ))}
                </ul>
            </div>
        </nav>

        <!-- CATEGORY FEED -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-9">
                <div class="space-y-20">
                    {categories.map((cat) => {
                        const posts = getCategoryPosts(cat.id);
                        if (posts.length === 0) return null;
                        const [firstPost, ...listPosts] = posts.slice(0, 5);

                        return (
                            <section id={cat.id} class="wsj-double-rule pt-4 scroll-mt-24">
                                <h2 class="text-[12px] font-black uppercase tracking-[0.2em] mb-6 inline-block border-b-4 border-black text-black pb-1">
                                    {cat.label}
                                </h2>
                                <div class="grid grid-cols-1 md:grid-cols-9 gap-6">
                                    <div class="md:col-span-3 column-divider md:pr-6">
                                        <article class="group">
                                            <div class="aspect-[4/3] overflow-hidden bg-gray-100 mb-3 border border-gray-200">
                                                <img src={firstPost.data.image} class="w-full h-full object-cover" alt={firstPost.data.title}/>
                                            </div>
                                            <a href={getUrl(firstPost.id)}>
                                                <h3 class="text-[15px] font-bold text-black group-hover:text-[#990000] leading-tight font-serif">
                                                    {firstPost.data.title}
                                                </h3>
                                            </a>
                                        </article>
                                    </div>
                                    <div class="md:col-span-6">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                                            {listPosts.map((post) => (
                                                <article class="border-b border-gray-100 pb-2 last:border-0">
                                                    <a href={getUrl(post.id)} class="group">
                                                        <h4 class="text-[13px] font-bold text-black group-hover:underline leading-snug mb-1">{post.data.title}</h4>
                                                        <p class="text-[11px] text-gray-600 line-clamp-2 leading-relaxed">{post.data.description}</p>
                                                    </a>
                                                </article>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </section>
                        );
                    })}
                </div>
            </div>

            <!-- SIDEBAR POPULAR -->
            <aside class="lg:col-span-3">
                <div class="sticky top-24">
                    <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-black pb-1 text-black">Most Popular</h4>
                    <div class="divide-y divide-gray-200">
                        {mostPopular.map((post, index) => (
                            <div class="flex gap-4 py-4 first:pt-0">
                                <span class="text-2xl font-serif font-bold text-gray-300 italic leading-none">{index + 1}</span>
                                <a href={getUrl(post.id)} class="group">
                                    <h5 class="text-[12px] font-bold text-black leading-tight group-hover:text-[#990000]">{post.data.title}</h5>
                                </a>
                            </div>
                        ))}
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <Footer />

</body>
</html>