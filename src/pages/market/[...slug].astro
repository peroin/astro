---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets'; // Mengoptimalkan performa gambar
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const marketPosts = await getCollection('blog', ({ id }) => {
    return id.startsWith('market/');
  });

  return marketPosts.map(post => ({
    params: { 
      slug: post.id.replace('market/', '') 
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Mengambil berita terbaru khusus kategori market untuk widget sidebar
const latestMarketNews = (await getCollection('blog', ({ id }) => id.startsWith('market/')))
  .filter(p => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// JSON-LD untuk mempercepat Google Indexing (Target E-E-A-T)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "image": [post.data.image],
  "datePublished": post.data.pubDate.toISOString(),
  "author": [{
      "@type": "Person",
      "name": "Iqbal Maulana",
      "url": "https://chainpulse.io/author/iqbal-maulana"
    }]
};
---

<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO 
        title={`${post.data.title} | Market Intelligence`} 
        description={post.data.description}
        image={post.data.image}
    />
    
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --wsj-bg: #fffcf5;
            --brand-red: #990000;
        }
        body { background-color: var(--wsj-bg); color: #1a1a1a; font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        
        /* Styling Artikel ala Koran Profesional */
        .prose h2 { font-family: 'Playfair Display', serif; font-size: 1.85rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid #e5e5e5; padding-bottom: 0.5rem; color: #000; }
        .prose p { margin-bottom: 1.5rem; line-height: 1.85; font-size: 1.15rem; color: #2d2d2d; }
        .prose blockquote { border-left: 4px solid var(--brand-red); padding-left: 1.5rem; font-style: italic; margin: 2.5rem 0; color: #444; font-size: 1.25rem; }
        .prose ul { list-style: disc; margin-left: 1.5rem; margin-bottom: 1.5rem; }
        .prose li { margin-bottom: 0.5rem; }
        
        /* Skeleton placeholder untuk widget */
        .ad-placeholder { background: #f0f0f0; border: 1px dashed #ccc; display: flex; align-items: center; justify-content: center; color: #999; font-size: 10px; font-weight: bold; text-transform: uppercase; }
    </style>
</head>

<body class="antialiased">

    <header class="border-b border-black py-4 bg-white sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
            <a href="/market" class="text-[10px] font-black uppercase tracking-widest flex items-center gap-2 hover:text-[#990000] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Market Intelligence
            </a>
            <div class="font-serif font-black italic text-xl uppercase tracking-tighter">
                Daily <span class="text-[#990000]">RWA</span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <article class="lg:col-span-8">
                <div class="flex items-center gap-2 mb-6">
                    <span class="bg-[#990000] text-white text-[9px] font-black uppercase px-2 py-0.5 tracking-tighter">Market Report</span>
                    <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">{post.data.category || 'Analysis'}</span>
                </div>

                <h1 class="text-4xl md:text-6xl font-serif font-black leading-[1.1] mb-6 text-slate-900 tracking-tight">
                    {post.data.title}
                </h1>

                <div class="flex flex-wrap items-center gap-4 py-4 border-y border-gray-200 mb-8 text-[11px] font-bold text-gray-500 uppercase">
                    <span class="text-black">By Iqbal Maulana</span>
                    <span class="hidden md:inline">|</span>
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                </div>

                <div class="ad-placeholder w-full h-[100px] mb-8">
                    Top Article Advertisement Area (Responsive)
                </div>

                {post.data.image && (
                    <div class="mb-10 group overflow-hidden border border-gray-200">
                        <img 
                            src={post.data.image} 
                            alt={post.data.title} 
                            class="w-full h-auto object-cover"
                        />
                        <div class="bg-white p-3 text-[10px] italic text-gray-500 border-t border-gray-200">
                            Asset Illustration: Market Data & Research Visualization.
                        </div>
                    </div>
                )}

                <div class="prose max-w-none">
                    <Content />
                </div>

                <div class="my-12 ad-placeholder w-full h-[250px]">
                    In-Content Market Research Promotion / Ad Unit
                </div>

                <section class="mt-16 bg-slate-900 text-white p-8 md:p-12 text-center relative overflow-hidden">
                    <div class="relative z-10">
                        <h3 class="text-2xl font-serif italic mb-2">Join the RWA Revolution</h3>
                        <p class="text-slate-400 text-sm mb-6 max-w-md mx-auto">Dapatkan analisis eksklusif mengenai tokenisasi aset dan tren pasar Solana langsung di inbox Anda.</p>
                        <form class="flex flex-col md:flex-row gap-2 max-w-md mx-auto">
                            <input type="email" placeholder="Your best email" class="flex-grow p-3 text-black text-sm focus:outline-none" required />
                            <button class="bg-[#990000] hover:bg-red-700 px-6 py-3 text-[11px] font-black uppercase tracking-widest transition-colors">Subscribe</button>
                        </form>
                    </div>
                    <div class="absolute top-0 right-0 opacity-10 font-serif text-9xl -mr-10 -mt-10">RWA</div>
                </section>
            </article>

            <aside class="lg:col-span-4">
                <div class="sticky top-24 space-y-12">
                    
                    <div class="p-4 bg-white border border-gray-200 shadow-sm">
                        <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b border-black pb-1">Real-Time Pulse</h4>
                        <div class="tradingview-widget-container">
                            <div class="tradingview-widget-container__widget"></div>
                            <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js" async is:inline>
                            {
                              "colorTheme": "light",
                              "dateRange": "1D",
                              "showChart": false,
                              "locale": "en",
                              "width": "100%",
                              "height": 250,
                              "largeChartUrl": "",
                              "isTransparent": true,
                              "showSymbolLogo": true,
                              "tabs": [
                                {
                                  "title": "Crypto",
                                  "symbols": [
                                    { "s": "BITSTAMP:BTCUSD", "d": "BTC" },
                                    { "s": "BINANCE:SOLUSD", "d": "SOL" },
                                    { "s": "BINANCE:RENDERUSD", "d": "RENDER" }
                                  ]
                                }
                              ]
                            }
                            </script>
                        </div>
                    </div>

                    <div class="ad-placeholder aspect-square w-full">
                        Sticky Sidebar Ad (300x300 / 300x600)
                    </div>

                    <section>
                        <h4 class="text-[11px] font-black uppercase tracking-[0.2em] mb-6 border-b-2 border-black pb-1">Latest Market News</h4>
                        <div class="space-y-8">
                            {latestMarketNews.map(item => (
                                <a href={`/market/${item.id.replace('market/', '')}`} class="group block border-b border-gray-100 pb-4 last:border-0">
                                    <h5 class="font-bold text-sm leading-tight group-hover:text-[#990000] transition-colors mb-2">
                                        {item.data.title}
                                    </h5>
                                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-tighter">
                                        {item.data.pubDate.toLocaleDateString('id-ID', { month: 'short', day: 'numeric', year: 'numeric' })}
                                    </p>
                                </a>
                            ))}
                        </div>
                    </section>
                </div>
            </aside>

        </div>
    </main>

    <Footer />
</body>
</html>