---
import Layout from '../layouts/Layout.astro';
import CryptoBentoGrid from '../components/CryptoBentoGrid.jsx';
import CryptoChart from '../components/CryptoChart.jsx';
import LiveTicker from '../components/LiveTicker.jsx';
import TokenomicsCalculator from '../components/TokenomicsCalculator.jsx';

// Komponen RWA & E-E-A-T
import RWAYieldTable from '../components/RWAYieldTable.jsx';
import TVLChart from '../components/TVLChart.jsx';
import AuthorBio from '../components/AuthorBio.astro';
import RWALiveTable from '../components/RWALiveTable.jsx';

// Import Footer dari path yang benar
import Footer from '../components/Footer.astro';

// SEO & Metadata - DailyRWA
const title = "Digital Assets & RWA Intelligence | DailyRWA";
const description = "Analisis on-chain mendalam untuk aset digital dan real-world assets. Bagian dari DailyRWA Network.";

// Definisi Menu Navbar DailyRWA
const navMenu = [
  { name: "Home", href: "/" },
  { name: "World", href: "/world" },
  { name: "Market", href: "/market" },
  { name: "Company", href: "/company" },
  { name: "Digital Asset", href: "/digital-asset", active: true },
];

const toc = [
  { id: "market-analysis", title: "Market Analysis" },
  { id: "rwa-analytics", title: "RWA On-Chain" },
  { id: "yield-aggregator", title: "Yield Aggregator" },
  { id: "valuation-sandbox", title: "RWA Sandbox" },
];
---

<Layout title={title} description={description}>
    <!-- DAILYRWA GLOBAL NAVBAR -->
    <header class="fixed top-0 w-full z-[110] bg-[#0d0d0d] border-b border-white/10 shadow-md">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 group">
                <span class="text-xl font-black tracking-tighter text-white uppercase italic transition-colors">
                    Daily<span class="text-[#ff3333] font-sans not-italic">RWA</span>
                </span>
            </a>

            <nav class="hidden md:flex items-center gap-8">
                {navMenu.map(item => (
                    <a 
                        href={item.href} 
                        class={`text-[10px] font-black uppercase tracking-[0.2em] transition-all duration-300 ${item.active ? 'text-[#ff3333] border-b-2 border-[#ff3333] pb-1' : 'text-gray-400 hover:text-white'}`}
                    >
                        {item.name}
                    </a>
                ))}
            </nav>

            <div class="flex items-center gap-4">
                <div class="hidden sm:flex flex-col items-end">
                    <span class="text-[8px] font-bold text-[#ff3333] uppercase tracking-widest leading-none">Market Open</span>
                    <span class="text-[9px] font-mono text-gray-400 uppercase">24/7 Intel</span>
                </div>
                <div class="h-8 w-[1px] bg-white/10 mx-2"></div>
                <button class="text-white hover:text-[#ff3333] transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative min-h-[80vh] w-full overflow-hidden flex flex-col justify-center items-center pt-24 pb-20 bg-[#f8f9fa]">
        <div class="absolute inset-0 z-0 opacity-15 grayscale">
            <img 
                src="https://images.unsplash.com/photo-1639762681485-074b7f938ba0?q=80&w=2832&auto=format&fit=crop" 
                alt="" 
                class="w-full h-full object-cover" 
                loading="eager"
            />
            <div class="absolute inset-0 bg-[#f8f9fa]/50"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
            <div class="flex items-center justify-center gap-3 mb-10 animate-fade-in">
                <div class="h-[1px] w-12 bg-[#333333]/20"></div>
                <span class="text-[10px] font-black tracking-[0.5em] text-[#333333] uppercase font-mono italic">Sector: Digital Asset</span>
                <div class="h-[1px] w-12 bg-[#333333]/20"></div>
            </div>
            
            <h1 class="text-6xl md:text-[9rem] font-serif font-black tracking-tighter leading-[0.85] mb-8 animate-reveal uppercase italic text-[#333333]">
                CRYPTO
            </h1>
            
            <p class="max-w-2xl mx-auto text-gray-600 text-base md:text-xl leading-relaxed font-medium mb-12 animate-fade-in font-sans">
                Laporan pasar aset digital dan real-world asset (RWA) ter-tokenisasi. Bagian eksklusif dari portal berita <span class="text-[#ff3333] font-bold">DailyRWA</span>.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                 <a href="#market-analysis" class="w-full sm:w-auto px-10 py-4 bg-[#333333] text-white font-black rounded-lg hover:bg-[#ff3333] transition-all shadow-md uppercase text-[10px] tracking-[0.2em] active:scale-95 text-center">Live Market Feed</a>
                 <a href="#rwa-analytics" class="w-full sm:w-auto px-10 py-4 bg-white text-[#333333] text-center font-black rounded-lg border border-[#333333]/20 hover:border-[#333333]/60 transition-all uppercase text-[10px] tracking-[0.2em] active:scale-95 shadow-sm">RWA Analytics</a>
            </div>
        </div>

        <div class="absolute bottom-0 w-full border-y border-[#333333]/10 bg-white py-4 overflow-hidden group">
            <LiveTicker client:only="react" />
        </div>
    </section>

    <!-- Main Content Area -->
    <main class="relative z-10 bg-[#f8f9fa]">
        
        <!-- PLACEMENT IKLAN 1: BILLBOARD AD (Top Page Banner) -->
        <div class="max-w-7xl mx-auto px-6 mt-8">
            <div class="w-full bg-white border border-[#333333]/10 py-6 text-center flex flex-col items-center justify-center rounded-xl shadow-sm group">
                <span class="text-[8px] font-black tracking-widest text-gray-400 uppercase mb-1">Sponsored Advertisement</span>
                <div class="text-xs font-mono font-medium text-gray-400 border border-dashed border-[#333333]/20 group-hover:text-[#333333] group-hover:border-[#333333]/40 transition-colors px-8 py-2 rounded">
                    Leaderboard Ad Space (e.g., 728x90 or Flexible Responsive)
                </div>
            </div>
        </div>
        
        <!-- Section: Market Analysis -->
        <section id="market-analysis" class="max-w-7xl mx-auto px-6 py-16 space-y-12 scroll-mt-32">
            <div class="flex items-center gap-4">
                <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-[#ff3333] font-mono italic whitespace-nowrap">Asset Performance Matrix</h2>
                <div class="h-[1px] flex-grow bg-[#333333]/15"></div>
            </div>
            <div class="bg-white rounded-xl p-4 md:p-10 border border-[#333333]/10 shadow-sm min-h-[300px]">
                <CryptoBentoGrid client:only="react" />
            </div>
            <div class="rounded-xl overflow-hidden border border-[#333333]/10 bg-white shadow-sm h-[500px] md:h-[650px]">
                <CryptoChart client:only="react" />
            </div>
        </section>

        <!-- Section RWA Analytics -->
        <section id="rwa-analytics" class="max-w-7xl mx-auto px-6 py-16 scroll-mt-32">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16">
                <div class="lg:col-span-5 space-y-6 text-center lg:text-left">
                    <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-[#ff3333] font-mono italic">Liquidity Tracking</h2>
                    <h3 class="text-4xl md:text-5xl font-serif font-bold text-[#333333] uppercase tracking-tighter italic">RWA Sector <br/>Analytics</h3>
                    <p class="text-gray-500 leading-relaxed font-sans text-lg">Pemantauan likuiditas on-chain pada protokol aset dunia nyata.</p>
                </div>
                
                <div class="lg:col-span-7 bg-[#222222] rounded-xl p-6 border border-[#333333]/25 shadow-xl min-h-[450px]">
                    <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
                        <span class="text-[10px] font-bold text-gray-300 uppercase tracking-[0.2em] font-mono">Real-Time TVL Data</span>
                        <div class="flex gap-2">
                            <div class="w-2 h-2 rounded-full bg-[#ff3333] animate-pulse"></div>
                            <div class="w-2 h-2 rounded-full bg-zinc-700"></div>
                        </div>
                    </div>
                    <TVLChart client:only="react" />
                </div>
            </div>

            <div class="rounded-xl border border-[#333333]/20 bg-[#222222] overflow-hidden shadow-md">
                <div class="p-0 text-white">
                     <RWALiveTable client:only="react" />
                </div>
            </div>
        </section>

        <!-- Section: Yield Aggregator -->
        <section id="yield-aggregator" class="bg-white py-20 border-y border-[#333333]/10 scroll-mt-32">
            <div class="max-w-7xl mx-auto px-6 text-center">
                <h2 class="text-3xl md:text-5xl font-serif font-black text-[#333333] uppercase italic tracking-tighter mb-8">Yield Aggregator</h2>
                <div class="bg-[#f8f9fa] p-4 border border-[#333333]/10 rounded-xl shadow-inner max-w-4xl mx-auto">
                    <RWAYieldTable client:only="react" />
                </div>
            </div>
        </section>

        <!-- Sandbox & Author Bio Area -->
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 py-16">
            <aside class="hidden lg:block lg:col-span-3 sticky top-32 h-fit">
                <nav class="space-y-8">
                    <p class="text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 mb-6 font-mono">Quick Navigation</p>
                    <ul class="space-y-4">
                        {toc.map(item => (
                            <li>
                                <a href={`#${item.id}`} class="toc-link group flex items-center gap-3 text-[11px] font-bold text-gray-500 hover:text-[#ff3333] transition-all font-sans uppercase tracking-widest">
                                    <span class="h-[1px] w-4 bg-gray-300 indicator-line group-hover:bg-[#ff3333]"></span>
                                    {item.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </aside>

            <div class="lg:col-span-9">
                <article class="prose prose-slate max-w-none">
                    
                    {/* PLACEMENT IKLAN 2: INLINE BANNER AD */}
                    <div class="w-full bg-white border border-[#333333]/10 py-5 text-center flex flex-col items-center justify-center rounded-xl shadow-sm mb-12 group">
                        <span class="text-[8px] font-black tracking-widest text-gray-400 uppercase mb-1">Sponsored Content</span>
                        <div class="text-[11px] font-mono text-gray-400 border border-dashed border-[#333333]/20 group-hover:text-[#333333] transition-colors px-6 py-1.5 rounded">
                            In-Article Premium Banner Ad
                        </div>
                    </div>

                    <section id="valuation-sandbox" class="mb-32 scroll-mt-32">
                        <div class="mb-10">
                            <h2 class="text-4xl font-serif font-black text-[#333333] mb-6 uppercase tracking-tight italic border-b-4 border-[#333333] inline-block">RWA Sandbox</h2>
                            <div class="bg-white border border-[#333333]/10 rounded-xl p-5 shadow-sm max-h-[550px] overflow-y-auto overflow-x-hidden custom-scrollbar">
                                <TokenomicsCalculator client:only="react" />
                            </div>
                        </div>
                    </section>
                    <div class="border-t border-[#333333]/15 pt-10">
                        <AuthorBio />
                    </div>
                </article>
            </div>
        </div>

        <!-- FOOTER KOMPONEN -->
        <Footer />
    </main>
</Layout>

<style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;600;900&display=swap');
    
    html { 
        scroll-behavior: smooth; 
        background-color: #f8f9fa; 
        font-family: 'Inter', sans-serif;
    }

    .font-serif { font-family: 'Playfair Display', serif; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #333333; border-radius: 2px; }

    #rwa-analytics table { color: #ffffff !important; }
    #rwa-analytics th { color: #ff3333 !important; font-weight: 900; }
    #rwa-analytics td { border-color: rgba(255,255,255,0.08) !important; }

    .animate-reveal { animation: reveal 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards; }
    @keyframes reveal {
        0% { transform: translateY(40px); opacity: 0; filter: blur(10px); }
        100% { transform: translateY(0); opacity: 1; filter: blur(0); }
    }
    .animate-fade-in { animation: fadeIn 1.5s ease-out forwards; }
    @keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f8f9fa; }
    ::-webkit-scrollbar-thumb { background: #dcdcdc; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #333333; }
</style>