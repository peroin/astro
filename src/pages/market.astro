---
import { getCollection } from 'astro:content';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');

// Memfilter post khusus kategori market
const marketPosts = allPosts
  .filter(post => post.id.startsWith('market/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [mainHeadline, ...otherPosts] = marketPosts;
const topStories = otherPosts.slice(0, 3);
const mostPopular = marketPosts.slice(0, 8); 

const getCategoryPosts = (slug: string) => marketPosts.filter(post => post.id.includes(`market/${slug}/`));
const getUrl = (id: string) => `/market/${id.replace('market/', '')}`;

const categories = [
    { id: 'rwa', label: 'RWA Tokens' },
    { id: 'stocks', label: 'US Stocks' },
    { id: 'crypto', label: 'Digital Assets' },
    { id: 'currencies', label: 'Currencies' },
    { id: 'commodities', label: 'Commodities' }
];

const marketHours = [
  { name: 'Forex', region: 'Global', open: 0, close: 24, type: 'Currencies' },
  { name: 'NYSE', region: 'New York', open: 14, close: 21, type: 'Stocks' },
  { name: 'LSE', region: 'London', open: 8, close: 16, type: 'Stocks' },
  { name: 'IDX', region: 'Jakarta', open: 2, close: 9, type: 'Stocks' },
  { name: 'Gold-Oil', region: 'Global', open: 0, close: 23, type: 'Commodities' }
];
---

<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="Market Intelligence | Daily RWA" description="Analisis ekonomi mendalam dan data pasar real-time." />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --wsj-bg: #fffcf5;
            --wsj-black: #1a1a1a;
            --brand-red: #990000;
        }
        body { background-color: var(--wsj-bg); color: var(--wsj-black); font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .wsj-double-rule { border-top: 3px double #000; }
        .wsj-thin-rule { border-top: 1px solid #d2d2d2; }
        .column-divider { border-right: 1px solid #e0e0e0; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .tv-widget-box { background: #ffffff; border: 1px solid #e0e3eb; border-radius: 4px; overflow: hidden; }

        @media (max-width: 1024px) {
            .column-divider { border-right: none; border-bottom: 1px solid #e0e0e0; padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
        }
    </style>
</head>

<body class="antialiased">

    <header class="max-w-7xl mx-auto px-4 pt-6 pb-4 text-center">
        <a href="/" class="inline-block">
            <h1 class="text-5xl md:text-6xl font-serif font-black italic tracking-tighter text-slate-900">
                DAILY <span class="text-[#990000]">RWA</span>
            </h1>
        </a>
    </header>

    <!-- TICKER TAPE (Hanya menggunakan data Liquid: Kripto, Forex, Saham) -->
    <div class="border-y border-black bg-white">
        <div class="tradingview-widget-container">
            <div class="tradingview-widget-container__widget"></div>
            <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js" async is:inline>
            {
              "symbols": [
                { "proName": "FOREXCOM:SPXUSD", "title": "S&P 500" },
                { "proName": "CAPITALCOM:DXY", "title": "US Dollar Index" },
                { "proName": "BITSTAMP:BTCUSD", "title": "Bitcoin" },
                { "proName": "BITSTAMP:ETHUSD", "title": "Ethereum" },
                { "proName": "BINANCE:SOLUSD", "title": "Solana" },
                { "proName": "OANDA:XAUUSD", "title": "Gold" }
              ],
              "showSymbolLogo": true,
              "colorTheme": "light",
              "isTransparent": true,
              "displayMode": "adaptive",
              "locale": "en"
            }
            </script>
        </div>
    </div>

    <nav class="border-b border-black bg-[#fffcf5] sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4">
            <ul class="flex justify-center items-center gap-6 md:gap-8 py-3 text-[11px] font-black uppercase tracking-[0.2em] overflow-x-auto no-scrollbar">
                <li><a href="/" class="hover:text-[#990000] whitespace-nowrap">Home</a></li>
                <li><a href="/market" class="text-[#990000] whitespace-nowrap">Market Intelligence</a></li>
                {categories.map(cat => (
                    <li><a href={`#${cat.id}`} class="hover:text-[#990000] whitespace-nowrap text-slate-700">{cat.label}</a></li>
                ))}
            </ul>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 mt-8">
        
        <!-- MARKET OVERVIEW (Tanpa US10Y & IEF) -->
        <div class="mb-8 border-b border-black pb-6">
            <div class="tv-widget-box">
                <div class="tradingview-widget-container">
                    <div class="tradingview-widget-container__widget"></div>
                    <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-market-overview.js" async is:inline>
                    {
                      "colorTheme": "light",
                      "dateRange": "1D",
                      "showChart": true,
                      "locale": "en",
                      "width": "100%",
                      "height": 400,
                      "largeChartUrl": "",
                      "isTransparent": false,
                      "showSymbolLogo": true,
                      "showFloatingTooltip": false,
                      "tabs": [
                        {
                          "title": "Major Assets",
                          "symbols": [
                            { "s": "FOREXCOM:SPXUSD", "d": "S&P 500" },
                            { "s": "CAPITALCOM:DXY", "d": "US Dollar Index" },
                            { "s": "OANDA:XAUUSD", "d": "Gold" },
                            { "s": "TVC:USOIL", "d": "WTI Crude" },
                            { "s": "BITSTAMP:BTCUSD", "d": "Bitcoin" },
                            { "s": "BINANCE:SOLUSD", "d": "Solana" }
                          ]
                        }
                      ]
                    }
                    </script>
                </div>
            </div>
        </div>

        <!-- MARKET STATUS BOARD -->
        <section class="mb-12">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Global Session Monitor (UTC)</h3>
            <div id="utc-clock" class="text-[10px] font-mono font-bold bg-black text-white px-2 py-1">--:--:-- UTC</div>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
            {marketHours.map((m) => (
              <div class="bg-white border border-gray-200 p-3 shadow-sm flex flex-col justify-between">
                <div class="flex justify-between items-start">
                  <span class="text-[8px] font-bold text-gray-400 uppercase tracking-tighter">{m.type}</span>
                  <div class={`status-dot-${m.name.replace(/\s+/g, '-')} w-2 h-2 rounded-full bg-gray-300 animate-pulse`}></div>
                </div>
                <h4 class="font-black text-xs uppercase italic my-1">{m.name}</h4>
                <div class={`status-label-${m.name.replace(/\s+/g, '-')} text-[8px] font-black uppercase py-1 text-center bg-gray-100`}>
                  Syncing...
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- KONTEN BLOG -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
            <section class="lg:col-span-8 column-divider lg:pr-8">
                {mainHeadline ? (
                    <article>
                        <div class="flex flex-col-reverse md:flex-row gap-6 mb-6">
                            <div class="md:w-1/3">
                                <a href={getUrl(mainHeadline.id)}>
                                    <h2 class="text-2xl md:text-3xl font-serif font-bold leading-tight mb-3 hover:text-[#990000] text-slate-900">
                                        {mainHeadline.data.title}
                                    </h2>
                                </a>
                                <p class="text-xs text-gray-700 leading-relaxed mb-4">{mainHeadline.data.description}</p>
                                <span class="text-[9px] font-bold text-[#990000] uppercase border-t border-[#990000] pt-1">Priority Analysis</span>
                            </div>
                            <div class="md:w-2/3">
                                <div class="aspect-video overflow-hidden border border-gray-200 shadow-sm">
                                    <img src={mainHeadline.data.image} alt={mainHeadline.data.title} class="w-full h-full object-cover" />
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 wsj-thin-rule pt-6">
                            {topStories.map(post => (
                                <article>
                                    <a href={getUrl(post.id)} class="group">
                                        <h3 class="text-sm font-bold leading-tight mb-1 group-hover:underline text-slate-900">{post.data.title}</h3>
                                        <p class="text-[10px] text-gray-500 line-clamp-2">{post.data.description}</p>
                                    </a>
                                </article>
                            ))}
                        </div>
                    </article>
                ) : (
                    <div class="p-10 border-2 border-dashed border-gray-200 text-center text-gray-400 italic font-serif">
                        No Market Intelligence Content Available.
                    </div>
                )}
            </section>

            <aside class="lg:col-span-4">
                <div class="mb-10">
                    <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-black pb-1 text-black">Economic Calendar</h4>
                    <div class="tv-widget-box min-h-[400px]">
                         <div class="tradingview-widget-container">
                            <div class="tradingview-widget-container__widget"></div>
                            <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-events.js" async is:inline>
                            {
                              "colorTheme": "light",
                              "isTransparent": false,
                              "width": "100%",
                              "height": "400",
                              "locale": "en",
                              "importanceFilter": "-1,0,1",
                              "currencyFilter": "USD,EUR,GBP,JPY,AUD,CAD,CNY"
                            }
                            </script>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <!-- DYNAMIC CATEGORIES -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-9">
                <div class="space-y-20">
                    {categories.map((cat) => {
                        const posts = getCategoryPosts(cat.id);
                        const hasPosts = posts.length > 0;
                        const [firstPost, ...listPosts] = hasPosts ? posts.slice(0, 5) : [null, []];

                        return (
                            <section id={cat.id} class="wsj-double-rule pt-4 scroll-mt-24">
                                <h2 class="text-[12px] font-black uppercase tracking-[0.2em] mb-6 inline-block border-b-4 border-black text-black pb-1">
                                    {cat.label} Intelligence
                                </h2>
                                
                                {hasPosts ? (
                                    <div class="grid grid-cols-1 md:grid-cols-9 gap-8">
                                        <div class="md:col-span-4 column-divider md:pr-6">
                                            <article class="group mb-8">
                                                <div class="aspect-[4/3] overflow-hidden bg-gray-100 mb-3 border border-gray-200 rounded-lg">
                                                    <img src={firstPost.data.image} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt={firstPost.data.title}/>
                                                </div>
                                                <a href={getUrl(firstPost.id)}>
                                                    <h3 class="text-[17px] font-bold text-black group-hover:text-[#990000] leading-tight font-serif">
                                                        {firstPost.data.title}
                                                    </h3>
                                                    <p class="text-xs text-gray-600 mt-2 line-clamp-3 leading-relaxed">{firstPost.data.description}</p>
                                                </a>
                                            </article>
                                        </div>
                                        <div class="md:col-span-5">
                                            {listPosts.map((post) => (
                                                <article class="border-b border-gray-100 pb-4 last:border-0 mb-4">
                                                    <a href={getUrl(post.id)} class="group flex gap-4 text-slate-900">
                                                        <div class="flex-grow">
                                                            <h4 class="text-[14px] font-bold text-black group-hover:underline leading-snug mb-1">{post.data.title}</h4>
                                                            <p class="text-[11px] text-gray-500 line-clamp-2 leading-relaxed">{post.data.description}</p>
                                                        </div>
                                                        {post.data.image && (
                                                            <div class="w-16 h-16 flex-shrink-0 bg-gray-100 border border-gray-200 rounded">
                                                                <img src={post.data.image} class="w-full h-full object-cover" alt="" />
                                                            </div>
                                                        )}
                                                    </a>
                                                </article>
                                            ))}
                                        </div>
                                    </div>
                                ) : (
                                    <div class="py-8 border border-dashed border-gray-200 text-center bg-gray-50/30">
                                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 italic">Analysis for {cat.label} is currently being prepared.</p>
                                    </div>
                                )}
                            </section>
                        );
                    })}
                </div>
            </div>

            <aside class="lg:col-span-3">
                <div class="sticky top-24">
                    <h4 class="text-[10px] font-black uppercase tracking-widest mb-4 border-b-2 border-black pb-1 text-black">Most Read</h4>
                    <div class="divide-y divide-gray-200">
                        {mostPopular.length > 0 ? mostPopular.map((post, index) => (
                            <div class="flex gap-4 py-4 first:pt-0 text-black">
                                <span class="text-3xl font-serif font-black text-gray-200 italic leading-none min-w-[30px]">{index + 1}</span>
                                <a href={getUrl(post.id)} class="group">
                                    <h5 class="text-[12px] font-bold text-black leading-tight group-hover:text-[#990000]">{post.data.title}</h5>
                                </a>
                            </div>
                        )) : <p class="text-[10px] text-gray-400 italic mt-4 uppercase">No trending data</p>}
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <Footer />

    <script is:inline define:vars={{ marketHours }}>
        function updateMarkets() {
          const now = new Date();
          const utcHour = now.getUTCHours();
          const utcDay = now.getUTCDay();
          const clock = document.getElementById('utc-clock');
          if(clock) clock.innerText = now.toISOString().split('T')[1].split('.')[0] + ' UTC';

          marketHours.forEach(m => {
            const safeName = m.name.replace(/\s+/g, '-');
            const dot = document.querySelector(`.status-dot-${safeName}`);
            const label = document.querySelector(`.status-label-${safeName}`);
            if(!dot || !label) return;

            const isWeekend = (utcDay === 0 || utcDay === 6);
            const isOpen = !isWeekend && (utcHour >= m.open && utcHour < m.close);

            if (isOpen || (m.name === 'Forex' && !isWeekend)) {
              dot.style.backgroundColor = '#22c55e';
              label.innerText = 'OPEN';
              label.className = `status-label-${safeName} text-[8px] font-black uppercase py-1 text-center bg-green-100 text-green-800`;
            } else {
              dot.style.backgroundColor = '#ef4444';
              label.innerText = 'CLOSED';
              label.className = `status-label-${safeName} text-[8px] font-black uppercase py-1 text-center bg-red-100 text-red-800`;
            }
          });
        }
        setInterval(updateMarkets, 1000);
        updateMarkets();
    </script>
</body>
</html>