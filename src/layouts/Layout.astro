---
// src/layouts/Layout.astro
interface Props {
	title?: string;
	description?: string;
	post?: any; // Mendukung metadata artikel otomatis
}

const { 
  title = "Dailyrwa Research | Institutional Asset Tokenization", 
  description = "Leading intelligence on Real World Asset tokenization and global digital finance regulation.",
  post
} = Astro.props;

// Konfigurasi Identitas Organisasi (Pembaruan ke Dailyrwa Research)
const orgName = "Dailyrwa Research"; 
const siteUrl = "https://dailyrwa.com";
const brandColor = "#990000";

// Logika deteksi URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteUrl);
const pathSegments = Astro.url.pathname.split('/').filter(segment => segment !== '');

// Cek apakah halaman saat ini adalah bagian dari ekosistem ChainPulse/Crypto (Nuansa Dark)
const isCryptoPage = pathSegments.includes('crypto') || pathSegments.includes('chainpulse');

// Membuat daftar elemen untuk JSON-LD Breadcrumbs
const breadcrumbItems = [
  { name: 'Home', item: siteUrl },
  ...pathSegments.map((segment, index) => {
    const url = `${siteUrl}/${pathSegments.slice(0, index + 1).join('/')}`;
    return {
      name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
      item: url
    };
  })
];

// Skema khusus artikel (Ubah Author dari Person ke Organization/Team jika diperlukan)
const articleSchema = post ? {
  "@context": "https://schema.org",
  "@type": "AnalysisNewsArticle",
  "headline": post.data.title || title,
  "description": post.data.description || description,
  "image": post.data.image ? [post.data.image] : [],
  "datePublished": post.data.pubDate?.toISOString(),
  "author": {
    "@type": "Organization", // Diubah menjadi Organization untuk kredibilitas institusi
    "name": orgName,
    "url": `${siteUrl}/about` 
  },
  "publisher": {
    "@type": "Organization",
    "name": orgName,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo.png`
    }
  }
} : null;

// Skema Organisasi Induk (Hanya muncul di Homepage)
const orgSchema = pathSegments.length === 0 ? {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": orgName,
  "alternateName": "Daily RWA",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "sameAs": [
    "https://x.com/dailyrwa" // Tambahkan link sosial media tim Anda jika ada
  ],
  "description": "Platform riset dan analisis independen fokus pada tokenisasi Real World Asset (RWA)."
} : null;
---

<!doctype html>
<html lang="id" class={isCryptoPage ? "bg-[#05070a]" : "bg-[#fff1e5]"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- 1. SKEMA BREADCRUMBS OTOMATIS -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": breadcrumbItems.map((item, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"name": item.name,
				"item": item.item
			}))
		})} />

		<!-- 2. SKEMA ARTIKEL ANALISIS (Muncul jika ada prop 'post') -->
		{articleSchema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
		)}

        <!-- 3. SKEMA ORGANISASI (Hanya di Homepage) -->
        {orgSchema && (
            <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
        )}

		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Playfair+Display:ital,wght@0,700;1,700&family=Space+Grotesk:wght@300;500;700&display=swap" rel="stylesheet">
	</head>

	<body class={isCryptoPage 
		? "bg-[#05070a] text-slate-300 antialiased" 
		: "bg-[#fff1e5] text-[#333] antialiased"}
	>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--ft-salmon: #fff1e5;
		--ft-ink: #333333;
		--ft-red: #990000;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'Inter', sans-serif;
		transition: background-color 0.3s ease;
		scroll-behavior: smooth;
	}

	.font-serif { font-family: 'Playfair Display', serif; }
	.font-crypto { font-family: 'Space Grotesk', sans-serif; }

	/* Global Corporate Styling */
	h1, h2, h3, h4 {
		letter-spacing: -0.02em;
	}

	img { display: block; max-width: 100%; height: auto; }

	/* Custom Scrollbar untuk ekosistem ChainPulse (Dark Mode) */
	.bg-[#05070a]::-webkit-scrollbar {
		width: 8px;
	}
	.bg-[#05070a]::-webkit-scrollbar-track {
		background: #05070a;
	}
	.bg-[#05070a]::-webkit-scrollbar-thumb {
		background: #1e293b;
		border-radius: 10px;
	}

    /* Selection Highlight */
    ::selection {
        background-color: #990000;
        color: white;
    }
</style>